      "url": "https://www.gov.uk/government/statistics/annual-bus-statistics-year-ending-march-2025/annual-bus-statistics-year-ending-march-2025"
    },
    "dft_income_quintile_trips": {
      "value": "Local bus trips/person/year, 2024: Q1 47.6 \u2026 Q5 13.0",
      "description": "National Travel Survey table NTS0705a, 2024, 'Other local bus' (outside London): average trips per person per year by household income quintile \u2014 Q1 47.6, Q2 37.5, Q3 24.8, Q4 18.5, Q5 13.0. Reference for the income gradient of bus use; not a calibration input in this pipeline.",
      "url": "https://www.gov.uk/government/statistical-data-sets/nts07-car-ownership-and-access"
    },
    "ons_population": {
      "value": "UK 68.3M / England 57.7M ~ 1.18",
      "description": "ONS mid-2023 population estimates, used to uplift England-only DfT bus finance to a UK total. Indicative: bus use per head varies by nation.",
      "url": "https://www.ons.gov.uk/peoplepopulationandcommunity/populationandmigration/populationestimates"
    },
    "nts_age_profile": {
      "value": "Bus trips by age; 17-20 peak",
      "description": "National Travel Survey 2023 bus trips by age (concessionary-adjusted). policyengine-uk uses this profile only to allocate reported household spending when journey data is absent; Microcosm UK supplies journeys.",
      "url": "https://www.gov.uk/government/statistics/national-travel-survey-2023/nts-2023-trips-by-purpose-age-mode-and-sex"
    },
    "current_fare_cap_policy": {
      "value": "\u00a33 funded until 31 March 2027",
      "description": "The existing national scheme funds a \u00a33 maximum single fare on participating services through March 2027. The new policy supersedes it from 1 January 2027, lowering the cap to \u00a32 and extending it through December.",
      "url": "https://www.gov.uk/guidance/3-national-bus-fare-cap"
    },
    "two_pound_announcement": {
      "value": "\u00a32 from 1 January 2027; \u00a3400m backs the cap",
      "description": "Government announcement of a \u00a32 maximum single fare on participating buses in England outside London throughout 2027. It says the cap is backed by \u00a3400m of extra funding, and that the \u00a3454m of extra funding in total (which includes funding for devolved governments) comes from reprioritising the DESNZ budget. Devolved governments receive Barnett consequentials 'in the usual way', but no amount is published for them, so the England / devolved split of the \u00a3454m is not stated. It does not publish a total scheme cost either.",
      "url": "https://www.gov.uk/government/news/cheaper-travel-for-millions-with-a-third-off-fares"
    },
    "dft_two_pound_cap_evaluation": {
      "value": "Table 6: singles \u00a32.73 \u2192 \u00a32.00; all tickets \u00a31.49 \u2192 \u00a31.40",
      "description": "DfT's evaluation of the first ten months of the previous \u00a32 cap. Affected singles (pre-cap price above \u00a32) fell 26.8%; the all-ticket average fell 6.3% on a 2022 ticket mix where singles were a minority of trips. Under cap regimes singles rose to ~85% of tickets sold.",
      "url": "https://www.gov.uk/government/publications/evaluation-of-the-2-bus-fare-cap"
    },
    "derived_fare_reduction": {
      "value": "12.5% all-ticket reduction (range 10-15%)",
      "description": "Derived for the \u00a33-to-\u00a32 change: singles priced at the \u00a33 cap save \u00a31 (33%) and those between \u00a32 and \u00a33 save less, giving roughly a 27% single yield reduction, weighted by a cap-era single trip share of 0.35-0.50. The evaluation's headline 6.3% is not used directly because it measures uncapped 2022 fares to \u00a32 on a pre-cap ticket mix.",
      "url": "https://www.gov.uk/government/publications/evaluation-of-the-2-bus-fare-cap"
    },
    "dft_regional_fare_split": {
      "value": "England \u00a33,417m: London \u00a31,347m / outside London \u00a32,070m",
      "description": "DfT Annual Bus Statistics table BUS05ai, year ending March 2025: passenger fare receipts by area. Benchmark for the London/outside-London split of simulated fares.",
      "url": "https://www.gov.uk/government/statistical-data-sets/bus-statistics-data-tables"
    },
    "three_pound_cap_2025_cost": {
      "value": "\u00a3151m one-year \u00a33 cap extension (2025) \u2192 8.3% cap-existence wedge",
      "description": "DfT put the one-year extension of the \u00a33 national bus fare cap at \u00a3151m for calendar 2025 \u2014 the cost of having a \u00a33 cap at all, versus uncapped commercial fares. That is operator reimbursement, so this analysis converts it to a household-savings basis by uprating 2025 fares to 2027 (~4%/yr) and grossing up the ~90% operator participation DfT achieved, giving ~\u00a3181m or 8.3% of projected outside-London fare spending.",
      "url": "https://www.gov.uk/government/publications/bus-service-improvement-plans-local-transport-authority-allocations/bus-service-operators-grant-local-transport-authority-final-allocations-2025-to-2026"
    },
    "funding_expiry_counterfactual": {
      "value": "\u00a33 cap funded only to 31 March 2027",
      "description": "Under current law the \u00a33 cap expires on 31 March 2027, so for nine of the twelve months of 2027 there would be no cap. Measured against that current-law counterfactual, the announcement buys three months of a \u00a33 \u2192 \u00a32 reduction plus nine months of uncapped \u2192 \u00a32, which is the basis the government's own funding figure is closest to.",
      "url": "https://www.gov.uk/guidance/3-national-bus-fare-cap"
    },
    "reported_scheme_cost": {
      "value": ">\u00a3500m expected total scheme cost",
      "description": "Contemporaneous PA reporting says the government expects the scheme to cost more than \u00a3500m. It reports \u00a3454m of new funding, with the balance from Department for Transport funding already allocated to buses. The GOV.UK press release itself does not state the total.",
      "url": "https://www.newburytoday.co.uk/national/burnham-announces-2-bus-fare-cap-from-january-169628/"
    }
  },
